#!/bin/bash
set -eo pipefail

script_dir=$(cd -- "$(dirname -- "${0}")" && pwd)
distribution="fedora"
release="44"
bridge_name="bridge-0"
bridge_address="10.203.17.1/24"
image_name="sandbox"
machine_dir="/var/lib/machines"
os_root="${machine_dir}/${image_name}"
agent_user="agent"

# dnf
sudo dnf -y upgrade
sudo dnf -y install systemd systemd-networkd systemd-container mkosi

# install the bridge
sudo mkdir -p /etc/systemd/network
sudo rm -f /etc/systemd/network/*

sudo install -m 644 /dev/stdin "/etc/systemd/network/${bridge_name}.netdev" << EOF
[NetDev]
Name=${bridge_name}
Kind=bridge
EOF

sudo install -m 644 /dev/stdin "/etc/systemd/network/${bridge_name}.network" << EOF
[Match]
Name=${bridge_name}

[Network]
Address=${bridge_address}
DHCPServer=yes
IPMasquerade=ipv4
ConfigureWithoutCarrier=yes
EOF

sudo systemctl enable --now systemd-networkd
sudo networkctl reload

# create the container
sudo systemctl stop "systemd-nspawn@${image_name}.service"
sudo machinectl remove "${image_name}" 2>/dev/null || true

install -m 644 /dev/stdin "${script_dir}/mkosi.conf" << EOF
[Distribution]
Distribution=${distribution}
Release=${release}

[Output]
Format=directory
OutputDirectory=${machine_dir}
Output=${image_name}

[Content]
Packages=
	fedora-release
	bash
	dnf
	sudo
	util-linux
	systemd
	systemd-networkd
WithRecommends=yes
RootPassword=hashed:
MachineId=random
Bootable=no
EOF

sudo mkosi --directory "${script_dir}" --force build
sudo systemctl --root "${os_root}" enable systemd-networkd
sudo useradd --root "${os_root}" --create-home --user-group --groups wheel "${agent_user}"
sudo passwd --root "${os_root}" --delete "${agent_user}"

sudo install -m 440 /dev/stdin "${os_root}/etc/sudoers.d/${agent_user}" << EOF
${agent_user} ALL=(ALL) NOPASSWD: ALL
EOF

sudo install -m 644 /dev/stdin "/etc/systemd/nspawn/${image_name}.nspawn" << EOF
[Exec]
NotifyReady=yes

[Network]
Bridge=${bridge_name}
EOF

sudo systemctl start "systemd-nspawn@${image_name}.service"
sudo machinectl shell "${agent_user}"@"${image_name}" /bin/bash -lc "sudo dnf -y upgrade"
