#!/bin/bash
set -eo pipefail

script_dir=$(cd -- "$(dirname -- "${0}")" && pwd)
image_name="sandbox"
image_root="/var/lib/machines/${image_name}"

packages=(
	bash
	coreutils
	dnf
	fedora-release
	shadow-utils
	sudo
	systemd
	systemd-networkd
	util-linux
)

sudo systemctl stop "systemd-nspawn@${image_name}.service"
sudo machinectl remove "${image_name}" 2>/dev/null || true
sudo mkdir -p "${image_root}"

sudo dnf -y \
	--installroot="${image_root}" \
	--releasever=44 \
	--use-host-config \
	--setopt=install_weak_deps=True \
	install "${packages[@]}"

sudo install -D -m 440 \
	"${script_dir}/mkosi/mkosi.extra/etc/sudoers.d/agent" \
	"${image_root}/etc/sudoers.d/agent"
sudo install -D -m 644 \
	"${script_dir}/mkosi/mkosi.extra/usr/lib/systemd/system-preset/10-sandbox.preset" \
	"${image_root}/usr/lib/systemd/system-preset/10-sandbox.preset"

sudo chroot "${image_root}" \
	useradd --create-home --user-group --groups wheel agent
sudo chroot "${image_root}" passwd --delete agent

sudo systemctl --root="${image_root}" preset-all
sudo systemd-machine-id-setup --root="${image_root}"

# machinectl only honors privileged nspawn settings such as Zone= from
# the trusted host configuration directories.
sudo install -D -m 644 \
	"${script_dir}/mkosi/mkosi.nspawn" \
	"/etc/systemd/nspawn/${image_name}.nspawn"

sudo machinectl enable "${image_name}"
sudo machinectl start "${image_name}"
