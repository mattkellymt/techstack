#!/bin/bash
set -eo pipefail

script_dir=$(cd -- "$(dirname -- "${0}")" && pwd)

# dnf
sudo dnf -y upgrade
sudo dnf -y install systemd systemd-networkd systemd-container

# mkosi's nspawn networking relies on systemd-networkd on the host.
sudo systemctl enable --now systemd-networkd

# image
"${script_dir}/build_image"
