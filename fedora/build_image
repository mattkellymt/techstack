#!/bin/bash
set -eo pipefail

script_dir=$(cd -- "$(dirname -- "${0}")" && pwd)
image_name="sandbox"
build_root=$(sudo mktemp -d --tmpdir=/dev/shm "${image_name}.XXXXXXXX")
oci_root="${build_root}/image"
bundle_root="${build_root}/bundle"
bundle_rootfs="${bundle_root}/rootfs"
machine_root="${script_dir}/machine"
host_root="${script_dir}/host"

cleanup() {
	sudo rm -rf -- "${build_root}"
}
trap cleanup EXIT

packages=(
	bash
	coreutils
	dnf
	fedora-release
	shadow-utils
	sudo
	systemd
	systemd-networkd
	util-linux
)

sudo skopeo copy \
	docker://registry.fedoraproject.org/fedora:44 \
	"oci:${oci_root}:44"
sudo umoci unpack \
	--image "${oci_root}:44" \
	"${bundle_root}"

sudo cp -R "${machine_root}/." "${bundle_rootfs}/"
sudo chroot "${bundle_rootfs}" dnf -y install "${packages[@]}"

sudo chroot "${bundle_rootfs}" chmod 440 /etc/sudoers.d/agent
sudo chroot "${bundle_rootfs}" \
	useradd --create-home --user-group --groups wheel agent
sudo chroot "${bundle_rootfs}" passwd --delete agent

sudo chroot "${bundle_rootfs}" systemctl enable systemd-networkd.service
sudo chroot "${bundle_rootfs}" rm -f /etc/machine-id
sudo chroot "${bundle_rootfs}" systemd-machine-id-setup

sudo systemctl stop "systemd-nspawn@${image_name}.service" 2>/dev/null || true
sudo machinectl remove "${image_name}" 2>/dev/null || true
sudo importctl import-fs "${bundle_rootfs}" "${image_name}"

# machinectl only honors privileged nspawn settings such as Bridge= from
# the trusted host configuration directories.
sudo install -D -m 644 \
	"${host_root}/etc/systemd/nspawn/${image_name}.nspawn" \
	"/etc/systemd/nspawn/${image_name}.nspawn"

sudo machinectl enable "${image_name}"
sudo machinectl start "${image_name}"
