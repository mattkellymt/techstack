#!/bin/bash
set -eo pipefail

script_dir=$(cd -- "$(dirname -- "${0}")" && pwd)
image_name="sandbox"
user="agent"

# dnf
sudo dnf -y upgrade
sudo dnf -y install systemd systemd-networkd systemd-container mkosi

# install the host config
sudo install -m 644 "${script_dir}/host/bridge-0.netdev" /etc/systemd/network/
sudo install -m 644 "${script_dir}/host/bridge-0.network" /etc/systemd/network/
sudo install -D -m 644 -t /etc/systemd/nspawn/ "${script_dir}/host/sandbox.nspawn"
sudo systemctl enable --now systemd-networkd
sudo networkctl reload

# build the container
sudo systemctl stop "systemd-nspawn@${image_name}.service"
sudo machinectl remove "${image_name}" 2>/dev/null || true
sudo mkosi --directory "${script_dir}/mkosi" --force build

# start the container
sudo systemctl start "systemd-nspawn@${image_name}.service"
sudo machinectl shell "${user}"@"${image_name}" /bin/bash -lc "sudo dnf -y upgrade"
