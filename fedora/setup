#!/bin/bash
set -eo pipefail

script_dir=$(cd -- "$(dirname -- "${0}")" && pwd)
distribution="fedora"
release="44"
bridge_name="bridge-0"
bridge_address="10.203.17.1/24"
image_name="sandbox"
machine_dir="/var/lib/machines"
os_root="${machine_dir}/${image_name}"
agent_user="agent"

bridge_netdev=$(cat << EOF
[NetDev]
Name=${bridge_name}
Kind=bridge
EOF
)

bridge_network=$(cat << EOF
[Match]
Name=${bridge_name}

[Network]
Address=${bridge_address}
DHCPServer=yes
IPMasquerade=ipv4
ConfigureWithoutCarrier=yes
EOF
)

image_nspawn=$(cat << EOF
[Exec]
NotifyReady=yes

[Network]
Bridge=${bridge_name}
EOF
)

agent_sudoers=$(cat << EOF
${agent_user} ALL=(ALL) NOPASSWD: ALL
EOF
)

mkosi_config=$(cat << EOF
[Distribution]
Distribution=${distribution}
Release=${release}

[Output]
Format=directory
OutputDirectory=${machine_dir}
Output=${image_name}

[Content]
Packages=
	fedora-release
	bash
	dnf
	sudo
	util-linux
	systemd
	systemd-networkd
WithRecommends=yes
RootPassword=hashed:
MachineId=random
Bootable=no
EOF
)

# dnf
sudo dnf -y upgrade
sudo dnf -y install systemd systemd-networkd systemd-container mkosi

# config files
sudo mkdir -p "${script_dir}"/config
rm -f "${script_dir}"/config/*
install -m 644 /dev/stdin "${script_dir}/config/${bridge_name}.netdev" <<< "${bridge_netdev}"
install -m 644 /dev/stdin "${script_dir}/config/${bridge_name}.network" <<< "${bridge_network}"
install -m 644 /dev/stdin "${script_dir}/config/${image_name}.nspawn" <<< "${image_nspawn}"
install -m 440 /dev/stdin "${script_dir}/config/${agent_user}.sudoers" <<< "${agent_sudoers}"
install -m 644 /dev/stdin "${script_dir}/config/${image_name}.mkosi.conf" <<< "${mkosi_config}"

# install the container bridge config
sudo mkdir -p /etc/systemd/network
sudo rm -f /etc/systemd/network/*
sudo install -m 644 "${script_dir}/config/${bridge_name}.netdev" "/etc/systemd/network/${bridge_name}.netdev"
sudo install -m 644 "${script_dir}/config/${bridge_name}.network" "/etc/systemd/network/${bridge_name}.network"
sudo systemctl enable --now systemd-networkd
sudo networkctl reload

# create the container
sudo systemctl stop "systemd-nspawn@${image_name}.service"
sudo machinectl remove "${image_name}" 2>/dev/null || true
sudo mkosi --directory "${script_dir}" --include "${script_dir}/config/${image_name}.mkosi.conf" --force build
sudo useradd --root "${os_root}" --create-home --user-group --groups wheel "${agent_user}"
sudo passwd --root "${os_root}" --delete "${agent_user}"
sudo install -m 440 "${script_dir}/config/${agent_user}.sudoers" "${os_root}/etc/sudoers.d/${agent_user}"

# start the container
sudo mkdir -p /etc/systemd/nspawn
sudo rm -f /etc/systemd/nspawn/*
sudo install -m 644 "${script_dir}/config/${image_name}.nspawn" "/etc/systemd/nspawn/${image_name}.nspawn"
sudo systemctl --root "${os_root}" enable systemd-networkd
sudo systemctl start "systemd-nspawn@${image_name}.service"
sudo machinectl shell "${agent_user}"@"${image_name}" /bin/bash -lc "sudo dnf -y upgrade"
