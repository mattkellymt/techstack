#!/bin/zsh
set -eo pipefail

github_dir="${HOME}/github.com/mattkellymt"
repo_dir="${github_dir}/techstack"
script_dir="${repo_dir}/macos"

# brew
if ! command -v brew >/dev/null 2>&1; then
	curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh | /bin/bash
fi

if [[ -x /opt/homebrew/bin/brew ]]; then
	brew_bin="/opt/homebrew/bin/brew"
else
	brew_bin="/usr/local/bin/brew"
fi

brew_shellenv="eval \"\$(${brew_bin} shellenv)\""

if ! grep -Fqx "${brew_shellenv}" "${HOME}/.zprofile" 2>/dev/null; then
	echo "${brew_shellenv}" >> "${HOME}/.zprofile"
fi

eval "$("${brew_bin}" shellenv)"
brew install jq yq uv git

# github
mkdir -p "${github_dir}"

if [[ ! -d "${repo_dir}" ]]; then
	cd "${github_dir}"
	git clone https://github.com/mattkellymt/techstack.git
fi

cd "${repo_dir}"
git fetch origin main
current_branch=$(git branch --show-current)

if [[ "${current_branch}" == "main" ]]; then
	git reset --hard origin/main
	git clean -fd
fi

# agents
"${script_dir}/install_agents"

# CLI
mkdir -p "${HOME}/.local/bin"
ln -sf "${script_dir}/stack" "${HOME}/.local/bin/stack"
