#!/bin/bash
set -eo pipefail

script_dir=$(cd -- "$(dirname -- "${0}")" && pwd)
export distribution="fedora"
export release="44"
export bridge_name="bridge-0"
export bridge_address="10.203.17.1/24"
export image_name="sandbox"
export machine_dir="/var/lib/machines"
export user="agent"
os_root="${machine_dir}/${image_name}"

config_dir=$(mktemp -d)
trap 'rm -rf "${config_dir}"' EXIT

render() {
	envsubst < "${script_dir}/templates/${1}" > "${config_dir}/${1}"
	echo "${config_dir}/${1}"
}

# dnf
sudo dnf -y upgrade
sudo dnf -y install systemd systemd-networkd systemd-container mkosi gettext-envsubst

# install the bridge
sudo mkdir -p /etc/systemd/network
sudo rm -f /etc/systemd/network/*
sudo install -m 644 "$(render bridge.netdev)" "/etc/systemd/network/${bridge_name}.netdev"
sudo install -m 644 "$(render bridge.network)" "/etc/systemd/network/${bridge_name}.network"
sudo systemctl enable --now systemd-networkd
sudo networkctl reload

# create the container
sudo systemctl stop "systemd-nspawn@${image_name}.service"
sudo machinectl remove "${image_name}" 2>/dev/null || true
sudo mkosi --include "$(render mkosi.conf)" --force build
sudo systemctl --root "${os_root}" enable systemd-networkd
sudo useradd --root "${os_root}" --create-home --user-group --groups wheel "${user}"
sudo passwd --root "${os_root}" --delete "${user}"
sudo install -m 440 "$(render sudoers)" "${os_root}/etc/sudoers.d/${user}"
sudo install -D -m 644 "$(render machine.nspawn)" "/etc/systemd/nspawn/${image_name}.nspawn"

# start the container
sudo systemctl start "systemd-nspawn@${image_name}.service"
sudo machinectl shell "${user}"@"${image_name}" /bin/bash -lc "sudo dnf -y upgrade"
