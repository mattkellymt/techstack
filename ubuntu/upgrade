#!/bin/bash
set -eo pipefail

repo_dir="${HOME}/github.com/mattkellymt/techstack"

# apt
sudo apt update -y
sudo apt upgrade -y

# brew
brew update
brew upgrade

# grok
curl -fsSL https://x.ai/cli/install.sh | bash

# github
cd "${repo_dir}"
git fetch origin main
current_branch=$(git branch --show-current)

if [[ "${current_branch}" == "main" ]]; then
	git reset --hard origin/main
	git clean -fd
fi
