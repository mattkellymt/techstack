#!/bin/bash
set -eo pipefail

github_dir="${HOME}/github.com/mattkellymt"
repo_dir="${github_dir}/techstack"
script_dir="${repo_dir}/ubuntu"

# apt
sudo apt update -y
sudo apt upgrade -y

sudo apt install -y \
	vim git curl htop pass \
	bubblewrap gawk zstd cmake build-essential

# github
mkdir -p "${github_dir}"

if [[ ! -d "${repo_dir}" ]]; then
	cd "${github_dir}"
	git clone https://github.com/mattkellymt/techstack.git
fi

cd "${repo_dir}"
git fetch origin main
current_branch=$(git branch --show-current)

if [[ "${current_branch}" == "main" ]]; then
	git reset --hard origin/main
	git clean -fd
fi

# brew
"${script_dir}/install_brew"
brew install jq yq uv

# agents
"${script_dir}/install_agents"

# CLI
mkdir -p "${HOME}/.local/bin"
ln -sf "${script_dir}/stack" "${HOME}/.local/bin/stack"
